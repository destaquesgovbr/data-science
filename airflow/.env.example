# Airflow Connections (AIRFLOW_CONN_{CONN_ID} format)
# Arquivo versionado: só placeholders. Copie para .env e preencha com os valores reais, ex.:
#   gcloud secrets versions access latest --secret=govbrnews-postgres-connection-string --project=inspire-7-finep
AIRFLOW_CONN_POSTGRES_DEFAULT=postgresql://USER:PASS@HOST:5432/govbrnews
AIRFLOW_CONN_AWS_BEDROCK=aws://ACCESS_KEY:SECRET_KEY@/?region_name=us-east-1

# Mock LLM — ativa classificação mock sem chamar Bedrock
MOCK_LLM=true
